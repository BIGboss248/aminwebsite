# ==============================================================================
# Next.js Application Environment Variables Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Core & Server Configuration
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
NEXT_PUBLIC_BASE_URL=https://meetjamali.com

# ------------------------------------------------------------------------------
# 2. Production & Deployment Configuration (Docker / Traefik)
# ------------------------------------------------------------------------------
DOMAIN=meetjamali.com
IMAGE_TAG=latest
TRAEFIK_NETWORK=traefik-net
CERT_RESOLVER=letsencrypt

# ------------------------------------------------------------------------------
# 3. Contact Form & Integrations
# ------------------------------------------------------------------------------
CONTACT_RECIPIENT_EMAIL=contact@meetjamali.com
RESEND_API_KEY=

# ------------------------------------------------------------------------------
# 4. Real User Monitoring (RUM) & Web Vitals
# ------------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_WEB_VITALS=true
NEXT_PUBLIC_VITALS_ENDPOINT=/api/telemetry/vitals

# ------------------------------------------------------------------------------
# 5. OpenTelemetry (OTel) Distributed Tracing
# ------------------------------------------------------------------------------
# Kill Switch: set to 'true' to completely disable OTel, 'false' or empty to enable
OTEL_SDK_DISABLED=false

# Service Name reported to telemetry collector
OTEL_SERVICE_NAME=aminwebsite

# Collector OTLP HTTP Endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# Protocol format (http/json recommended for readable debugging)
OTEL_EXPORTER_OTLP_PROTOCOL=http/json

# Batch schedule flush delay in milliseconds (1000ms for local dev, 5000ms for prod)
OTEL_BSP_SCHEDULE_DELAY=5000

# Diagnostic log level (warn / info / error / debug / none)
OTEL_LOG_LEVEL=warn

# Optional: Custom headers for remote collectors (e.g., Honeycomb, Datadog)
# OTEL_EXPORTER_OTLP_HEADERS=
