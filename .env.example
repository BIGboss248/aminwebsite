# ==============================================================================
# Next.js Application Environment Variables Specification (.env.example)
# Single Source of Truth for Environment Configuration & Production Deployments
# ==============================================================================
#
# NEXT.JS ENVIRONMENT VARIABLE LOAD ORDER PRECEDENCE:
# 1. System process.env (or container environment variables)
# 2. .env.$(NODE_ENV).local (e.g. .env.development.local, .env.production.local)
# 3. .env.local (ignored when NODE_ENV=test)
# 4. .env.$(NODE_ENV) (e.g. .env.development, .env.production)
# 5. .env (default fallback)
#
# SECURITY RULES:
# - NEVER commit '.env*.local' or secret keys (e.g. API keys, database credentials).
# - Variables prefixed with 'NEXT_PUBLIC_' are inlined into client JavaScript at build time.
# - Non-prefixed variables are strictly available in the server runtime (Node.js).
# - Whenever a new environment variable is introduced, append and document it here immediately.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Core & Server Configuration
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
NEXT_PUBLIC_BASE_URL=https://meetjamali.com

# ------------------------------------------------------------------------------
# 2. Server Action Encryption & Version Skew Protection
# ------------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# ------------------------------------------------------------------------------
# 3. Production & Reverse Proxy Configuration (Docker / Traefik / Nginx)
# ------------------------------------------------------------------------------
DOMAIN_NAME=meetjamali.com
CONTAINER_NAME=nextjs-standalone-app
IMAGE_TAG=latest
TRAEFIK_ROUTER_NAME=nextjs-app
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_TLS_ENABLED=true
TRAEFIK_CERTRESOLVER=letsencrypt

# ------------------------------------------------------------------------------
# 4. Contact Form & Email Integration
# ------------------------------------------------------------------------------
CONTACT_RECIPIENT_EMAIL=contact@meetjamali.com
RESEND_API_KEY=

# ------------------------------------------------------------------------------
# 5. Real User Monitoring (RUM) & Web Vitals
# ------------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_WEB_VITALS=true
NEXT_PUBLIC_VITALS_ENDPOINT=/api/telemetry/vitals

# ------------------------------------------------------------------------------
# 6. OpenTelemetry (OTel) Distributed Tracing
# ------------------------------------------------------------------------------
# Kill Switch: set to 'true' to completely disable OTel, 'false' to enable
OTEL_SDK_DISABLED=true

# Service Name reported to telemetry collector
OTEL_SERVICE_NAME=aminwebsite

# Collector OTLP HTTP Endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# Protocol format (http/json recommended for readable debugging)
OTEL_EXPORTER_OTLP_PROTOCOL=http/json

# Batch schedule flush delay in milliseconds (1000ms for local dev, 5000ms for prod)
OTEL_BSP_SCHEDULE_DELAY=5000

# Diagnostic log level (warn / info / error / debug / none)
OTEL_LOG_LEVEL=warn

# Optional: Custom headers for remote collectors (e.g., Honeycomb, Datadog)
# OTEL_EXPORTER_OTLP_HEADERS=

